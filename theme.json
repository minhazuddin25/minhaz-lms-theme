{
	"$schema": "https://schemas.wp.org/wp/6.8/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": { "contentSize": "760px", "wideSize": "1200px" },
		"color": {
			"palette": [
				{ "slug": "primary", "color": "#3157d5", "name": "Primary" },
				{ "slug": "primary-strong", "color": "#1d3ba8", "name": "Primary Strong" },
				{ "slug": "accent", "color": "#f59e0b", "name": "Accent" },
				{ "slug": "ink", "color": "#17203a", "name": "Ink" },
				{ "slug": "muted", "color": "#64708a", "name": "Muted" },
				{ "slug": "surface", "color": "#ffffff", "name": "Surface" },
				{ "slug": "surface-soft", "color": "#f6f8fc", "name": "Surface Soft" }
			],
			"gradients": [
				{ "slug": "hero", "gradient": "linear-gradient(135deg, #eff3ff 0%, #f8faff 55%, #fff5df 100%)", "name": "Hero" }
			]
		},
		"spacing": {
			"spacingSizes": [
				{ "slug": "xs", "size": "0.625rem", "name": "Extra Small" },
				{ "slug": "sm", "size": "1rem", "name": "Small" },
				{ "slug": "md", "size": "1.5rem", "name": "Medium" },
				{ "slug": "lg", "size": "2.5rem", "name": "Large" },
				{ "slug": "xl", "size": "clamp(3.5rem, 7vw, 6rem)", "name": "Extra Large" }
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{ "fontFamily": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif", "slug": "system-sans", "name": "System Sans" }
			],
			"fontSizes": [
				{ "slug": "small", "size": "0.875rem", "name": "Small" },
				{ "slug": "medium", "size": "1rem", "name": "Medium" },
				{ "slug": "large", "size": "1.25rem", "name": "Large" },
				{ "slug": "x-large", "size": "clamp(1.75rem, 4vw, 3rem)", "name": "Extra Large" }
			]
		}
	},
	"styles": {
		"color": { "text": "var:preset|color|ink", "background": "var:preset|color|surface" },
		"typography": { "fontFamily": "var:preset|font-family|system-sans", "lineHeight": "1.65" },
		"elements": {
			"button": { "border": { "radius": "0.5rem" }, "color": { "background": "var:preset|color|primary", "text": "#ffffff" }, "typography": { "fontWeight": "700" } },
			"link": { "color": { "text": "var:preset|color|primary" } }
		}
	}
}
